<!--
    Stash's icon set.

    Every icon is authored on a 24x24 grid as a stroked outline, matching the
    Fluent line-icon weight Windows 11 uses. They are stroked rather than filled
    so one path serves every size and colour, and they are hand-authored rather
    than taken from Segoe Fluent Icons because that font's private-use codepoints
    shift between Windows releases.

    Geometry is declared as the abstract Geometry type and parsed from the path
    mini-language by WPF's type converter.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==== View chips ==================================================== -->

    <!-- Clock face with hands. -->
    <Geometry x:Key="Icon.History">
        M3.2,12 A8.8,8.8 0 1 1 20.8,12 A8.8,8.8 0 1 1 3.2,12
        M12,7.2 L12,12 L15.8,14.2
    </Geometry>

    <!-- Five-point star. Drawn closed so it can be either filled or stroked. -->
    <Geometry x:Key="Icon.Star">
        M12,3.6 L14.55,9.15 L20.6,9.95 L16.15,14.2 L17.3,20.2
        L12,17.3 L6.7,20.2 L7.85,14.2 L3.4,9.95 L9.45,9.15 Z
    </Geometry>

    <!-- Three ragged lines, reading as a block of text. -->
    <Geometry x:Key="Icon.Text">
        M5,7.5 L19,7.5 M5,12 L16,12 M5,16.5 L11.5,16.5
    </Geometry>

    <!-- Two interlocking chain links. -->
    <Geometry x:Key="Icon.Link">
        M10.6,13.4 A4,4 0 0 1 10.6,7.75 L13.4,4.95
        A4,4 0 0 1 19.05,10.6 L17.65,12
        M13.4,10.6 A4,4 0 0 1 13.4,16.25 L10.6,19.05
        A4,4 0 0 1 4.95,13.4 L6.35,12
    </Geometry>

    <!-- Framed picture with a sun and a horizon. -->
    <Geometry x:Key="Icon.Image">
        M4.5,5.5 L19.5,5.5 A2,2 0 0 1 21.5,7.5 L21.5,16.5
        A2,2 0 0 1 19.5,18.5 L4.5,18.5 A2,2 0 0 1 2.5,16.5
        L2.5,7.5 A2,2 0 0 1 4.5,5.5 Z
        M7.1,10.3 A1.45,1.45 0 1 0 10,10.3 A1.45,1.45 0 1 0 7.1,10.3
        M3.2,16.2 L9.4,11.4 L13.2,14.7 L16.3,12.2 L21,16.1
    </Geometry>

    <!-- Folder with a tab. -->
    <Geometry x:Key="Icon.Folder">
        M3,7.6 A1.6,1.6 0 0 1 4.6,6 L9.1,6 L11.2,8.6
        L19.4,8.6 A1.6,1.6 0 0 1 21,10.2 L21,17.4
        A1.6,1.6 0 0 1 19.4,19 L4.6,19 A1.6,1.6 0 0 1 3,17.4 Z
    </Geometry>

    <!-- Rising line with an arrowhead. -->
    <Geometry x:Key="Icon.Trending">
        M4,16.5 L9.5,11 L13,14.5 L20,7.5
        M20,7.5 L15.2,7.5 M20,7.5 L20,12.3
    </Geometry>

    <!-- ==== Clip kinds ==================================================== -->

    <!-- Paint droplet. -->
    <Geometry x:Key="Icon.Color">
        M12,3.4 C12,3.4 6.4,9.6 6.4,13.6 A5.6,5.6 0 0 0 17.6,13.6
        C17.6,9.6 12,3.4 12,3.4 Z
    </Geometry>

    <!-- ==== Chrome ======================================================== -->

    <Geometry x:Key="Icon.Search">
        M4.2,10.6 A6.4,6.4 0 1 1 17,10.6 A6.4,6.4 0 1 1 4.2,10.6
        M15.3,15.3 L20.4,20.4
    </Geometry>

    <Geometry x:Key="Icon.Close">
        M6.8,6.8 L17.2,17.2 M17.2,6.8 L6.8,17.2
    </Geometry>

    <!-- Two sliders, standing in for a gear: far more legible at 14px. -->
    <Geometry x:Key="Icon.Settings">
        M3.5,8.5 L20.5,8.5 M3.5,15.5 L20.5,15.5
        M7.3,8.5 A2.2,2.2 0 1 0 11.7,8.5 A2.2,2.2 0 1 0 7.3,8.5
        M12.3,15.5 A2.2,2.2 0 1 0 16.7,15.5 A2.2,2.2 0 1 0 12.3,15.5
    </Geometry>

    <!-- Drag handle: two stacked rails. -->
    <Geometry x:Key="Icon.Grip">
        M7.5,10 L16.5,10 M7.5,14 L16.5,14
    </Geometry>

    <Geometry x:Key="Icon.Copy">
        M8.5,8.5 L18,8.5 A1.6,1.6 0 0 1 19.6,10.1 L19.6,19
        A1.6,1.6 0 0 1 18,20.6 L8.5,20.6 A1.6,1.6 0 0 1 6.9,19
        L6.9,10.1 A1.6,1.6 0 0 1 8.5,8.5 Z
        M4.6,15.4 A1.6,1.6 0 0 1 3,13.8 L3,4.9
        A1.6,1.6 0 0 1 4.6,3.3 L13.5,3.3
    </Geometry>

    <Geometry x:Key="Icon.Delete">
        M4.5,7.4 L19.5,7.4
        M9.6,7.4 L9.6,5.6 A1.1,1.1 0 0 1 10.7,4.5 L13.3,4.5
        A1.1,1.1 0 0 1 14.4,5.6 L14.4,7.4
        M6.6,7.4 L7.6,18.9 A1.6,1.6 0 0 0 9.2,20.4 L14.8,20.4
        A1.6,1.6 0 0 0 16.4,18.9 L17.4,7.4
        M10.6,10.9 L10.6,16.9 M13.4,10.9 L13.4,16.9
    </Geometry>

    <!-- Box with an arrow leaving it. -->
    <Geometry x:Key="Icon.Open">
        M14.2,4.3 L19.7,4.3 L19.7,9.8 M19.7,4.3 L12.1,11.9
        M16.8,13.9 L16.8,18.2 A1.6,1.6 0 0 1 15.2,19.8 L5.9,19.8
        A1.6,1.6 0 0 1 4.3,18.2 L4.3,8.9 A1.6,1.6 0 0 1 5.9,7.3
        L10.2,7.3
    </Geometry>

    <!-- Question mark in a circle. -->
    <Geometry x:Key="Icon.Help">
        M3.4,12 A8.6,8.6 0 1 1 20.6,12 A8.6,8.6 0 1 1 3.4,12
        M9.3,9.5 A2.7,2.7 0 1 1 12,12.2 L12,14.2
        M12,16.8 L12,17.2
    </Geometry>

    <Geometry x:Key="Icon.Check">
        M5,12.4 L9.6,17 L19,7.2
    </Geometry>

    <Geometry x:Key="Icon.Warning">
        M12,3.8 L21.2,19.2 L2.8,19.2 Z
        M12,9.4 L12,14.2 M12,16.6 L12,17.2
    </Geometry>

    <!-- Numeric keypad key, marking the quick-slot affordance. -->
    <Geometry x:Key="Icon.Slot">
        M5.5,4.5 L18.5,4.5 A1.6,1.6 0 0 1 20.1,6.1 L20.1,17.9
        A1.6,1.6 0 0 1 18.5,19.5 L5.5,19.5 A1.6,1.6 0 0 1 3.9,17.9
        L3.9,6.1 A1.6,1.6 0 0 1 5.5,4.5 Z
        M10.4,9.2 L12.4,8 L12.4,16 M9.8,16 L15,16
    </Geometry>

</ResourceDictionary>
