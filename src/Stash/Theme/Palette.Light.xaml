<!--
    Light palette. Mirrors Palette.Dark.xaml key for key, so the two can be
    swapped at runtime without touching any style.

    Note that light mode inverts the surface strategy: cards are near-opaque white
    with a hairline border, because low-alpha blacks over acrylic turn muddy.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Panel -->
    <SolidColorBrush x:Key="Brush.Panel" Color="#DCF4F4F6" />
    <SolidColorBrush x:Key="Brush.PanelBorder" Color="#1F000000" />
    <SolidColorBrush x:Key="Brush.Divider" Color="#14000000" />

    <!-- Cards -->
    <SolidColorBrush x:Key="Brush.Card" Color="#F2FFFFFF" />
    <SolidColorBrush x:Key="Brush.CardHover" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.CardBorder" Color="#1A000000" />
    <SolidColorBrush x:Key="Brush.CardSelected" Color="#FFFFFFFF" />

    <!-- Text -->
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#FF17171A" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#A8000000" />
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="#70000000" />

    <!-- Chips -->
    <SolidColorBrush x:Key="Brush.Chip" Color="#0A000000" />
    <SolidColorBrush x:Key="Brush.ChipHover" Color="#14000000" />
    <SolidColorBrush x:Key="Brush.ChipBorder" Color="#14000000" />

    <!-- Search field -->
    <SolidColorBrush x:Key="Brush.Search" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.SearchBorder" Color="#26000000" />

    <!-- Buttons -->
    <SolidColorBrush x:Key="Brush.ButtonHover" Color="#14000000" />
    <SolidColorBrush x:Key="Brush.ButtonPressed" Color="#0A000000" />
    <SolidColorBrush x:Key="Brush.DangerHover" Color="#22E81123" />

    <!-- Accents (replaced at runtime) -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#FF0078D4" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#2E0078D4" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FFFFFFFF" />

    <!-- Favourite star -->
    <SolidColorBrush x:Key="Brush.Star" Color="#FFE0A200" />

    <!-- Checkerboard shown behind transparent images -->
    <SolidColorBrush x:Key="Brush.CheckerA" Color="#14000000" />
    <SolidColorBrush x:Key="Brush.CheckerB" Color="#08000000" />

    <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#59000000" />
    <SolidColorBrush x:Key="Brush.ScrollThumbHover" Color="#8C000000" />

</ResourceDictionary>
