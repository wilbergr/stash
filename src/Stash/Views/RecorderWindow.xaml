<Window x:Class="Stash.Views.RecorderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Record a macro"
        Width="520"
        Height="620"
        MinWidth="440"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="True"
        Background="{DynamicResource Brush.Panel}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{DynamicResource Font.Ui}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid Margin="20,18,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==== Status / what recording means ========================== -->
        <Border Grid.Row="0"
                x:Name="StatusBox"
                Background="{DynamicResource Brush.Card}"
                BorderBrush="{DynamicResource Brush.CardBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,12,14,13">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="RecordDot"
                             Width="10"
                             Height="10"
                             Fill="{DynamicResource Brush.TextTertiary}"
                             VerticalAlignment="Center"
                             Margin="0,0,9,0" />
                    <TextBlock x:Name="StatusText"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.TextPrimary}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock x:Name="StatusHint"
                           Style="{StaticResource SettingsCaption}"
                           Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <!-- ==== Name and hotkey ======================================== -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Name" Style="{StaticResource SettingsLabel}" />
                <TextBox x:Name="NameBox" Style="{StaticResource SettingsTextBox}" Margin="0,6,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="2" Width="170">
                <TextBlock Text="Hotkey" Style="{StaticResource SettingsLabel}" />
                <TextBox x:Name="HotkeyBox" Style="{StaticResource SettingsTextBox}" Margin="0,6,0,0" />
            </StackPanel>
        </Grid>

        <!-- ==== Captured steps ========================================= -->
        <Border Grid.Row="2"
                Margin="0,16,0,0"
                Background="{DynamicResource Brush.Search}"
                BorderBrush="{DynamicResource Brush.SearchBorder}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <ScrollViewer x:Name="StepScroller" Padding="12,10,12,10" VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}" />
                    </ScrollViewer.Resources>

                    <ItemsControl x:Name="StepList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Style="{StaticResource KeyCap}"
                                            MinWidth="52"
                                            VerticalAlignment="Top"
                                            Margin="0,1,9,0">
                                        <TextBlock Text="{Binding Kind}"
                                                   Style="{StaticResource KeyCapText}"
                                                   HorizontalAlignment="Center" />
                                    </Border>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Detail}"
                                               FontFamily="{DynamicResource Font.Mono}"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock x:Name="EmptyHint"
                           Text="Nothing captured yet."
                           Style="{StaticResource SettingsCaption}"
                           Margin="0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False" />
            </Grid>
        </Border>

        <!-- ==== Editing the capture ==================================== -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="RecordButton"
                        Style="{StaticResource PrimaryButton}"
                        Content="Start recording"
                        Margin="0,0,8,0" />
                <Button x:Name="UndoButton"
                        Style="{StaticResource SecondaryButton}"
                        Content="Undo last"
                        Margin="0,0,8,0" />
                <Button x:Name="ClearButton"
                        Style="{StaticResource SecondaryButton}"
                        Content="Clear" />
            </StackPanel>

            <CheckBox x:Name="PausesCheck"
                      Style="{StaticResource ThemedCheckBox}"
                      Content="Record pauses"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center" />
        </Grid>

        <!-- ==== Footer ================================================= -->
        <Grid Grid.Row="4" Margin="0,16,0,0">
            <TextBlock x:Name="ErrorText"
                       Style="{StaticResource SettingsCaption}"
                       Margin="0,0,140,0"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton"
                        Style="{StaticResource SecondaryButton}"
                        Content="Cancel"
                        Margin="0,0,8,0"
                        IsCancel="True" />
                <Button x:Name="SaveButton"
                        Style="{StaticResource PrimaryButton}"
                        Content="Save macro" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
