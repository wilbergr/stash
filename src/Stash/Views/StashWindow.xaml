<Window x:Class="Stash.Views.StashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Stash.ViewModels"
        mc:Ignorable="d"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        d:DataContext="{d:DesignInstance Type=vm:StashViewModel}"
        Title="Stash"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="{DynamicResource Font.Ui}"
        WindowStartupLocation="Manual"
        Left="-4000"
        Top="-4000"
        Width="600"
        Height="300">

    <Window.Resources>

        <!-- Checkerboard drawn behind transparent images, so a PNG with alpha
             does not read as a solid block. -->
        <DrawingBrush x:Key="CheckerBrush"
                      TileMode="Tile"
                      Viewport="0,0,16,16"
                      ViewportUnits="Absolute"
                      Stretch="None">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="{DynamicResource Brush.CheckerB}">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,16,16" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="{DynamicResource Brush.CheckerA}">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,8,8" />
                                <RectangleGeometry Rect="8,8,8,8" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- ==== Shared card internals ==================================== -->

        <!-- The metadata strip along the bottom of every card. -->
        <DataTemplate x:Key="CardMetaTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Path Grid.Column="0"
                      Data="{Binding KindIconKey, Converter={StaticResource IconKeyToGeometry}}"
                      Stroke="{DynamicResource Brush.TextTertiary}"
                      StrokeThickness="1.4"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      Stretch="Uniform"
                      Width="11"
                      Height="11"
                      Margin="0,0,6,0"
                      VerticalAlignment="Center" />

                <TextBlock Grid.Column="1"
                           Foreground="{DynamicResource Brush.TextTertiary}"
                           FontSize="10.5"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center">
                    <Run Text="{Binding KindLabel, Mode=OneWay}" />
                    <Run Text="  ·  " />
                    <Run Text="{Binding TimeAgo, Mode=OneWay}" />
                </TextBlock>

                <!-- Quick-slot badge: only present once a slot is assigned. -->
                <Border Grid.Column="2"
                        Background="{DynamicResource Brush.Accent}"
                        CornerRadius="4"
                        Width="16"
                        Height="16"
                        Margin="4,0,0,0"
                        VerticalAlignment="Center"
                        ToolTip="Assigned to a quick slot"
                        Visibility="{Binding HasSlot, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding SlotLabel}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.OnAccent}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
            </Grid>
        </DataTemplate>

        <!-- The per-kind body. Exactly one child is visible; the flags come from
             the view model rather than converters. -->
        <DataTemplate x:Key="CardBodyTemplate">
            <Grid>
                <!-- Text -->
                <TextBlock Text="{Binding Body}"
                           Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}"
                           Foreground="{DynamicResource Brush.TextPrimary}"
                           FontSize="12"
                           LineHeight="16"
                           LineStackingStrategy="BlockLineHeight"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis" />

                <!-- Link -->
                <StackPanel Visibility="{Binding IsLink, Converter={StaticResource BoolToVis}}"
                            VerticalAlignment="Top">
                    <TextBlock Text="{Binding Domain}"
                               Foreground="{DynamicResource Brush.TextPrimary}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding LinkPath}"
                               Foreground="{DynamicResource Brush.TextSecondary}"
                               FontSize="11"
                               Margin="0,3,0,0"
                               MaxHeight="46"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- Image -->
                <Border Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}"
                        Background="{StaticResource CheckerBrush}"
                        CornerRadius="6"
                        ClipToBounds="True">
                    <Image Source="{Binding Thumbnail}"
                           Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>

                <!-- Files -->
                <StackPanel Visibility="{Binding IsFiles, Converter={StaticResource BoolToVis}}"
                            VerticalAlignment="Top">
                    <ItemsControl ItemsSource="{Binding FileNames}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                           FontSize="11.5"
                                           Margin="0,0,0,2"
                                           TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Colour -->
                <StackPanel Visibility="{Binding IsColor, Converter={StaticResource BoolToVis}}"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Width="34"
                            Height="34"
                            CornerRadius="8"
                            Background="{Binding ColorSwatch}"
                            BorderBrush="{DynamicResource Brush.CardBorder}"
                            BorderThickness="1" />
                    <TextBlock Text="{Binding Preview}"
                               Foreground="{DynamicResource Brush.TextPrimary}"
                               FontFamily="{DynamicResource Font.Mono}"
                               FontSize="12"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- ==== Tile card: used when the stash is docked top or bottom ==== -->

        <DataTemplate x:Key="TileCardTemplate">
            <!-- Height is deliberately unset: the card stretches to fill the row,
                 so its metadata strip stays visible whatever height the user has
                 dragged the stash to. -->
            <Border x:Name="Card"
                    Width="210"
                    VerticalAlignment="Stretch"
                    Margin="0,0,8,0"
                    Background="{DynamicResource Brush.Card}"
                    BorderBrush="{DynamicResource Brush.CardBorder}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="11,9,11,8"
                    Cursor="Hand"
                    SnapsToDevicePixels="True">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding DataContext.ActivateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}" />
                </Border.InputBindings>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Source app, and the star -->
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock Text="{Binding SourceApp}"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,26,0"
                                   VerticalAlignment="Center" />

                        <Button HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,-4,-6,0"
                                Style="{StaticResource StarButton}"
                                Tag="{Binding IsFavorite}"
                                ToolTip="Favorite (Ctrl+D)"
                                Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                    </Grid>

                    <ContentControl Grid.Row="1"
                                    Content="{Binding}"
                                    ContentTemplate="{StaticResource CardBodyTemplate}"
                                    IsTabStop="False" />

                    <ContentControl Grid.Row="2"
                                    Margin="0,7,0,0"
                                    Content="{Binding}"
                                    ContentTemplate="{StaticResource CardMetaTemplate}"
                                    IsTabStop="False" />

                    <!-- Hover actions, floating over the body -->
                    <StackPanel x:Name="Actions"
                                Grid.Row="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Opacity="0">
                        <Button Style="{StaticResource IconButton}"
                                Width="26"
                                Height="26"
                                Tag="{StaticResource Icon.Copy}"
                                ToolTip="Copy without pasting (Alt+C)"
                                Command="{Binding DataContext.CopyOnlyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                        <!-- Hidden for text and colour clips: there is nothing to
                             open, and an inert button next to Copy is worse than
                             no button at all. -->
                        <Button Style="{StaticResource IconButton}"
                                Width="26"
                                Height="26"
                                Tag="{StaticResource Icon.Open}"
                                ToolTip="{Binding OpenLabel}"
                                Visibility="{Binding CanOpen, Converter={StaticResource BoolToVis}}"
                                Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                        <Button Style="{StaticResource IconButton.Danger}"
                                Width="26"
                                Height="26"
                                Tag="{StaticResource Icon.Delete}"
                                ToolTip="Remove from history (Alt+Delete)"
                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                    </StackPanel>
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource Brush.CardSelected}" />
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                    <Setter TargetName="Card" Property="BorderThickness" Value="1.5" />
                </DataTrigger>
                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource Brush.CardHover}" />
                    <Setter TargetName="Actions" Property="Opacity" Value="1" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ==== Row card: used when the stash is docked left or right ===== -->

        <DataTemplate x:Key="RowCardTemplate">
            <Border x:Name="Row"
                    Margin="0,0,0,6"
                    Background="{DynamicResource Brush.Card}"
                    BorderBrush="{DynamicResource Brush.CardBorder}"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="10,8,10,8"
                    Cursor="Hand"
                    SnapsToDevicePixels="True">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding DataContext.ActivateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}" />
                </Border.InputBindings>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <ContentControl Content="{Binding}"
                                        ContentTemplate="{StaticResource CardBodyTemplate}"
                                        MaxHeight="64"
                                        IsTabStop="False" />
                        <ContentControl Content="{Binding}"
                                        ContentTemplate="{StaticResource CardMetaTemplate}"
                                        Margin="0,6,0,0"
                                        IsTabStop="False" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Top"
                                Margin="6,-2,-4,0">
                        <Button Style="{StaticResource StarButton}"
                                Tag="{Binding IsFavorite}"
                                ToolTip="Favorite (Ctrl+D)"
                                Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                        <Button x:Name="RowDelete"
                                Style="{StaticResource IconButton.Danger}"
                                Width="26"
                                Height="26"
                                Opacity="0"
                                Tag="{StaticResource Icon.Delete}"
                                ToolTip="Remove from history (Alt+Delete)"
                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                    </StackPanel>
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.CardSelected}" />
                    <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                    <Setter TargetName="Row" Property="BorderThickness" Value="1.5" />
                </DataTrigger>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.CardHover}" />
                    <Setter TargetName="RowDelete" Property="Opacity" Value="1" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ==== Items panels ============================================== -->

        <ItemsPanelTemplate x:Key="HorizontalCardsPanel">
            <VirtualizingStackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>

        <ItemsPanelTemplate x:Key="VerticalCardsPanel">
            <VirtualizingStackPanel Orientation="Vertical" />
        </ItemsPanelTemplate>

        <!-- Containers carry no chrome of their own: the DataTemplate draws
             everything, including the selected state. -->
        <Style x:Key="BareItemContainer" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- WindowRoot is transparent and deliberately larger than the panel: the
         extra room is what the panel slides through, and it is clipped by the
         screen edge rather than by the window. -->
    <Grid x:Name="WindowRoot" Background="Transparent">

        <Border x:Name="PanelRoot"
                Background="{DynamicResource Brush.Panel}"
                BorderBrush="{DynamicResource Brush.PanelBorder}"
                BorderThickness="1"
                CornerRadius="12"
                SnapsToDevicePixels="True">

            <Border.RenderTransform>
                <TranslateTransform x:Name="SlideTransform" />
            </Border.RenderTransform>

            <Border.Effect>
                <DropShadowEffect BlurRadius="26"
                                  ShadowDepth="5"
                                  Direction="270"
                                  Opacity="0.42"
                                  Color="#FF000000"
                                  RenderingBias="Performance" />
            </Border.Effect>

            <Grid>
                <!-- A lit top edge, which is what stops a flat translucent panel
                     from looking like a plain rectangle. -->
                <Border CornerRadius="11" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="#16FFFFFF" />
                            <GradientStop Offset="0.35" Color="#00FFFFFF" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Grid Margin="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- ==== Header (also the drag handle) ================= -->
                    <Border x:Name="HeaderBar"
                            Grid.Row="0"
                            Background="Transparent"
                            Padding="12,10,10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0"
                                  Data="{StaticResource Icon.Grip}"
                                  Stroke="{DynamicResource Brush.TextTertiary}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Stretch="Uniform"
                                  Width="14"
                                  Height="14"
                                  Margin="0,0,9,0"
                                  VerticalAlignment="Center"
                                  ToolTip="Drag to move — release near an edge to dock" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Stash"
                                           FontFamily="{DynamicResource Font.Display}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding HotkeyHint}"
                                           Style="{StaticResource HintText}"
                                           Margin="9,1,0,0" />
                            </StackPanel>

                            <!-- Stretch, not Right. A right-aligned TextBox sizes to
                                 its content, so the field visibly grew and shrank
                                 as you typed. Stretching pins it to the column and
                                 MaxWidth stops it becoming absurd on a wide panel,
                                 while still letting it shrink in a narrow dock. -->
                            <TextBox x:Name="SearchBox"
                                     Grid.Column="2"
                                     Style="{StaticResource SearchBox}"
                                     Margin="16,0,10,0"
                                     MaxWidth="320"
                                     HorizontalAlignment="Stretch"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="HelpButton"
                                        Style="{StaticResource IconButton}"
                                        Tag="{StaticResource Icon.Help}"
                                        ToolTip="How to use Stash (F1)" />
                                <Button x:Name="SettingsButton"
                                        Style="{StaticResource IconButton}"
                                        Tag="{StaticResource Icon.Settings}"
                                        ToolTip="Settings (Ctrl+,)" />
                                <Button x:Name="CloseButton"
                                        Style="{StaticResource IconButton}"
                                        Tag="{StaticResource Icon.Close}"
                                        ToolTip="Close (Esc)" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ==== View chips =================================== -->
                    <ItemsControl Grid.Row="1"
                                  ItemsSource="{Binding Chips}"
                                  Margin="12,0,12,8"
                                  KeyboardNavigation.TabNavigation="None">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <!-- Wraps so the chips still fit when the stash is
                                     docked to a narrow left/right edge. -->
                                <WrapPanel Orientation="Horizontal" ItemHeight="36" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ChipButton}"
                                        Command="{Binding DataContext.SelectViewCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- ==== Cards ======================================== -->
                    <Grid Grid.Row="2">
                        <ListBox x:Name="CardList"
                                 ItemsSource="{Binding Cards}"
                                 SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource BareItemContainer}"
                                 ItemTemplate="{StaticResource TileCardTemplate}"
                                 ItemsPanel="{StaticResource HorizontalCardsPanel}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="12,2,12,2"
                                 Focusable="False"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 ScrollViewer.CanContentScroll="True">
                            <ListBox.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}" />
                            </ListBox.Resources>
                        </ListBox>

                        <!-- Empty state -->
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                            <Path Data="{StaticResource Icon.History}"
                                  Stroke="{DynamicResource Brush.TextTertiary}"
                                  StrokeThickness="1.3"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Stretch="Uniform"
                                  Width="26"
                                  Height="26"
                                  Opacity="0.7"
                                  HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding EmptyMessage}"
                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                       FontSize="12.5"
                                       Margin="0,10,0,0"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- ==== Footer ======================================= -->
                    <Border Grid.Row="3"
                            BorderBrush="{DynamicResource Brush.Divider}"
                            BorderThickness="0,1,0,0"
                            Padding="13,7,13,8">
                        <Grid>
                            <!-- Keyboard legend. A WrapPanel of keycap/label pairs so
                                 it reflows instead of overflowing in the narrow
                                 left and right docks. -->
                            <WrapPanel x:Name="Legend"
                                       Orientation="Horizontal"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding HasToast, Converter={StaticResource InverseBoolToVis}}">
                                <WrapPanel.Resources>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Orientation" Value="Horizontal" />
                                        <Setter Property="Margin" Value="0,1,14,1" />
                                    </Style>
                                </WrapPanel.Resources>

                                <StackPanel>
                                    <Border Style="{StaticResource KeyCap}">
                                        <TextBlock Text="Enter" Style="{StaticResource KeyCapText}" />
                                    </Border>
                                    <TextBlock Text="paste" Style="{StaticResource HintText}" />
                                </StackPanel>

                                <StackPanel>
                                    <Border Style="{StaticResource KeyCap}">
                                        <TextBlock Text="Ctrl+1-9" Style="{StaticResource KeyCapText}" />
                                    </Border>
                                    <TextBlock Text="quick pick" Style="{StaticResource HintText}" />
                                </StackPanel>

                                <StackPanel>
                                    <Border Style="{StaticResource KeyCap}">
                                        <TextBlock Text="Alt+1-9" Style="{StaticResource KeyCapText}" />
                                    </Border>
                                    <TextBlock Text="assign slot" Style="{StaticResource HintText}" />
                                </StackPanel>

                                <StackPanel>
                                    <Border Style="{StaticResource KeyCap}">
                                        <TextBlock Text="Ctrl+D" Style="{StaticResource KeyCapText}" />
                                    </Border>
                                    <TextBlock Text="favorite" Style="{StaticResource HintText}" />
                                </StackPanel>

                                <StackPanel>
                                    <Border Style="{StaticResource KeyCap}">
                                        <TextBlock Text="Ctrl+←→↑↓" Style="{StaticResource KeyCapText}" />
                                    </Border>
                                    <TextBlock Text="dock" Style="{StaticResource HintText}" />
                                </StackPanel>
                            </WrapPanel>

                            <!-- Toast takes the legend's place while it is showing. -->
                            <Border HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource Brush.AccentSoft}"
                                    CornerRadius="6"
                                    Padding="9,3,9,4"
                                    Visibility="{Binding HasToast, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding Toast}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.TextPrimary}" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Resize grip on the inner edge; the code-behind positions it to
                     match the current dock. -->
                <Thumb x:Name="ResizeGrip"
                       Width="Auto"
                       Height="6"
                       VerticalAlignment="Top"
                       HorizontalAlignment="Stretch"
                       Margin="14,0,14,0"
                       Opacity="0"
                       Background="Transparent"
                       Cursor="SizeNS">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Border Background="Transparent">
                                <Border Background="{DynamicResource Brush.TextTertiary}"
                                        CornerRadius="2"
                                        Width="40"
                                        Height="3"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
            </Grid>
        </Border>
    </Grid>
</Window>
