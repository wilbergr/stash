<Application x:Class="Stash.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <!--
        No StartupUri: Stash has no main window. It lives in the tray and creates
        the stash window itself, hidden, so the first press of the hotkey shows an
        already-built visual tree.

        MergedDictionaries[0] is the palette and is swapped wholesale when the
        theme changes, so its position here is load-bearing.
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Palette.Dark.xaml" />
                <ResourceDictionary Source="Theme/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
